# Métricas sociais (somente leitura). Veja README.md antes de preencher.
# Meta: token com acesso à Página e/ou conta profissional do Instagram.
META_GRAPH_VERSION=v27.0
# Use instagram para o token gerado por "Generate Instagram Access Token"; deixe vazio para Facebook Login.
META_IG_LOGIN=instagram
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_IG_ACCESS_TOKEN=

# TikTok: preencha só a chave e o segredo do app (Sandbox > Credentials) e rode `npm run tiktok:autorizar`.
# Os tokens ficam em .env.tiktok e são renovados sozinhos a cada coleta.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube: access token opcional; para renovação, preencha as três variáveis abaixo.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
